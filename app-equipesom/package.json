{
  "name": "app-equipesom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:b3": "node scripts/start-b3-local.mjs",
    "build": "npm run verify:environment-contract && tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "node --max-old-space-size=512 scripts/verify-prototype.mjs",
    "test:smtp-proof": "node server/smtp/smtpProof.test.mjs",
    "verify:prototype": "node --max-old-space-size=512 scripts/verify-prototype.mjs",
    "verify:smtp-connection": "node --env-file=server/smtp/.env server/smtp/verifyHostopiaConnection.mjs",
    "test:access-foundation": "supabase test db",
    "verify:access-foundation:static": "node scripts/verify-access-foundation.mjs",
    "verify:local-auth": "node scripts/verify-local-auth.mjs",
    "verify:b3-readonly": "node scripts/verify-b3-readonly.mjs",
    "prepare:b3-manual": "node scripts/manage-b3-manual-access.mjs prepare",
    "cleanup:b3-manual": "node scripts/manage-b3-manual-access.mjs cleanup",
    "verify:b2-concurrency": "node scripts/verify-b2-counter-concurrency.mjs",
    "verify:environment-contract": "node scripts/verify-environment-contract.mjs",
    "start:access-foundation": "supabase start -x realtime,storage-api,imgproxy,studio,edge-runtime,logflare,vector,supavisor",
    "export:access-foundation": "supabase db dump --local --schema public,private --file supabase/exports/access-foundation.sql",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "nodemailer": "^10.0.1",
    "supabase": "^2.116.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  }
}
