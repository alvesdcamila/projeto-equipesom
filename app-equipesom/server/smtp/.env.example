# Exemplo exclusivamente server-side. Nunca use prefixo VITE_ nestas variáveis.
SMTP_HOST=mail.consolegroup.com.br
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=propostas@consolegroup.com.br
SMTP_PASSWORD=VALOR_FICTICIO_NAO_UTILIZAR
SMTP_FROM=propostas@consolegroup.com.br

# A verificação permanece bloqueada até esta confirmação ser definida no arquivo local ignorado.
SMTP_VERIFY_CONNECTION=NAO_EXECUTAR
